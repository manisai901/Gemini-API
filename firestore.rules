rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Validation Blueprints ---

    function isValidUser(data, isUpdate) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
             data.keys().size() <= 7 &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             (data.displayName == null || (data.displayName is string && data.displayName.size() <= 100)) &&
             (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (data.theme == null || data.theme in ['dark', 'light', 'system']) &&
             (isUpdate ? data.createdAt == existing().createdAt : data.createdAt == request.time) &&
             data.updatedAt == request.time;
    }

    function isValidSession(data, userId, isUpdate) {
      return data.keys().hasAll(['userId', 'title', 'createdAt', 'updatedAt']) &&
             data.keys().size() <= 6 &&
             data.userId == userId &&
             data.title is string && data.title.size() <= 200 &&
             (data.lastMessage == null || (data.lastMessage is string && data.lastMessage.size() <= 10000)) &&
             (isUpdate ? data.createdAt == existing().createdAt : data.createdAt == request.time) &&
             data.updatedAt == request.time;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['role', 'content', 'timestamp']) &&
             data.keys().size() == 3 &&
             data.role in ['user', 'assistant'] &&
             data.content is string && data.content.size() <= 20000 &&
             data.timestamp == request.time;
    }

    function isVerified() {
      // Relaxed for development or explicitly checking token
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming(), false);
      allow update: if isOwner(userId) && 
                      isValidUser(incoming(), true) && 
                      incoming().uid == existing().uid &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'theme', 'updatedAt']);
    }

    match /users/{userId}/sessions/{sessionId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(sessionId);
      allow create: if isOwner(userId) && isValidId(sessionId) && isValidSession(incoming(), userId, false);
      allow update: if isOwner(userId) && 
                      isValidId(sessionId) &&
                      isValidSession(incoming(), userId, true) &&
                      incoming().userId == existing().userId &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['title', 'lastMessage', 'updatedAt']);
      allow delete: if isOwner(userId);

      match /messages/{messageId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(messageId);
        allow create: if isOwner(userId) && isValidId(messageId) && isValidMessage(incoming());
        allow update, delete: if false;
      }
    }
  }
}
