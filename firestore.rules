rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Validation Blueprints ---

    function isValidUser(data, isUpdate) {
      let requiredKeys = ['uid', 'email', 'createdAt', 'updatedAt'];
      return (isUpdate ? data.keys().hasAny(requiredKeys) : data.keys().hasAll(requiredKeys)) &&
             data.keys().size() <= 7 &&
             (!data.keys().has('uid') || data.uid == request.auth.uid) &&
             (!data.keys().has('email') || (data.email is string && data.email.size() <= 256)) &&
             (!data.keys().has('displayName') || data.displayName == null || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!data.keys().has('photoURL') || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (!data.keys().has('theme') || data.theme in ['dark', 'light', 'system']) &&
             (!data.keys().has('createdAt') || (isUpdate ? data.createdAt == existing().createdAt : data.createdAt == request.time)) &&
             (!data.keys().has('updatedAt') || data.updatedAt == request.time);
    }

    function isValidSession(data, userId, isUpdate) {
      let requiredKeys = ['userId', 'title', 'createdAt', 'updatedAt'];
      return (isUpdate ? data.keys().hasAny(requiredKeys) : data.keys().hasAll(requiredKeys)) &&
             data.keys().size() <= 6 &&
             (!data.keys().has('userId') || data.userId == userId) &&
             (!data.keys().has('title') || (data.title is string && data.title.size() <= 200)) &&
             (!data.keys().has('lastMessage') || data.lastMessage == null || (data.lastMessage is string && data.lastMessage.size() <= 10000)) &&
             (!data.keys().has('createdAt') || (isUpdate ? data.createdAt == existing().createdAt : data.createdAt == request.time)) &&
             (!data.keys().has('updatedAt') || data.updatedAt == request.time);
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['role', 'content', 'timestamp']) &&
             data.keys().size() == 3 &&
             data.role in ['user', 'assistant'] &&
             data.content is string && data.content.size() <= 20000 &&
             data.timestamp == request.time;
    }

    function isVerified() {
      // Relaxed for development or explicitly checking token
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming(), false);
      allow update: if isOwner(userId) && 
                      isValidUser(incoming(), true) && 
                      incoming().uid == existing().uid &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'theme', 'updatedAt']);
    }

    match /users/{userId}/sessions/{sessionId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(sessionId);
      allow create: if isOwner(userId) && isValidId(sessionId) && isValidSession(incoming(), userId, false);
      allow update: if isOwner(userId) && 
                      isValidId(sessionId) &&
                      isValidSession(incoming(), userId, true) &&
                      incoming().userId == existing().userId &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['title', 'lastMessage', 'updatedAt']);
      allow delete: if isOwner(userId);

      match /messages/{messageId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(messageId);
        allow create: if isOwner(userId) && isValidId(messageId) && isValidMessage(incoming());
        allow update, delete: if false;
      }
    }
  }
}
